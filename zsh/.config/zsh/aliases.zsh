# Navigation and safer, readable defaults.
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -A'
alias mkdir='mkdir -p'

# Short Git commands not already supplied by the Oh My Zsh git plugin.
alias gst='git status --short --branch'
alias glog='git log --graph --decorate --oneline --all'

# macOS conveniences.
alias copy='pbcopy'
alias paste='pbpaste'
