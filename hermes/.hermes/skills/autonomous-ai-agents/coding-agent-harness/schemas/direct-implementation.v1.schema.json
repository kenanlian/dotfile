{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct-implementation.v1",
  "title": "direct-implementation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome",
    "summary",
    "residualRisks",
    "blockingIssues"
  ],
  "properties": {
    "schema": { "const": "direct-implementation.v1" },
    "outcome": { "enum": ["completed", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "residualRisks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockingIssues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "completed" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "blockingIssues": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "blocked" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "blockingIssues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ]
}
