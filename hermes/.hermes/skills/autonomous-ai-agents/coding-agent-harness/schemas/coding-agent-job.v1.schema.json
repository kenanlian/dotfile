{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-agent.job.v1",
  "title": "coding-agent.job.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "jobId",
    "idempotencyKey",
    "taskId",
    "stage",
    "attempt",
    "workspace",
    "agent",
    "permissions",
    "inputs",
    "expectedOutput",
    "verification",
    "limits"
  ],
  "properties": {
    "schema": { "const": "coding-agent.job.v1" },
    "jobId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["plan", "plan_review", "implement", "execute_review", "direct_implement"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoRoot", "branch", "expectedHead", "requireCleanAtStart"],
      "properties": {
        "repoRoot": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "expectedHead": { "type": "string", "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$" },
        "requireCleanAtStart": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "profile", "model", "thinking", "sessionId"],
      "properties": {
        "adapter": { "enum": ["pi", "cursor"] },
        "profile": {
          "enum": ["planner", "plan-reviewer", "implementer", "execute-reviewer"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "anyOf": [
            { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*/[A-Za-z0-9._:@/-]+$" },
            { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
          ]
        },
        "thinking": {
          "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
        },
        "sessionId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["read-only", "write"] }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": ["requirement", "plan", "plan-review", "implementation", "evidence"]
          },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema"],
      "properties": {
        "kind": {
          "enum": ["plan", "plan-review", "implementation", "execute-review", "direct-implementation"]
        },
        "schema": {
          "enum": ["plan.v1", "plan-review.v1", "implementation.v1", "execute-review.v1", "direct-implementation.v1"]
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "cwd", "timeoutSeconds", "expectedExitCode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "expectedExitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds"],
      "properties": {
        "timeoutSeconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 2147483
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "stage": { "const": "direct_implement" } },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "agent": {
            "properties": {
              "profile": { "const": "implementer" }
            },
            "required": ["profile"]
          },
          "permissions": {
            "properties": {
              "mode": { "const": "write" }
            },
            "required": ["mode"]
          },
          "expectedOutput": {
            "properties": {
              "kind": { "const": "direct-implementation" },
              "schema": { "const": "direct-implementation.v1" }
            },
            "required": ["kind", "schema"]
          },
          "inputs": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": {
                "kind": { "const": "requirement" }
              },
              "required": ["kind"]
            }
          },
          "verification": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
